# 同機多份部署須使用不同的 project name。
COMPOSE_PROJECT_NAME=studydy-competition
STUDYDY_PORT=4176
STUDYDY_PUBLIC_ORIGIN=http://127.0.0.1:4176
STUDYDY_SECURE_COOKIE=false
# 與 Nginx 共用的新上傳上限（bytes）；公開部署使用 94371840。
STUDYDY_UPLOAD_MAX_BYTES=104857600
# 資料路徑相對 repository；測試須使用獨立目錄。
STUDYDY_DATA_DIR=./.studydy-product/compose
STUDYDY_UID=1000
STUDYDY_GID=1000
STUDYDY_BACKEND_UID=20002

POSTGRES_DB=studydy_competition
POSTGRES_USER=studydy
# 必填私密密碼，只在執行時傳入容器。
POSTGRES_PASSWORD=

# 模型 origin 不含 /v1、帳密、query 或 fragment。
STUDYDY_SEMANTIC_BASE_URL=http://host.docker.internal:18000
VLLM_API_KEY=

# SSH：啟用 ssh profile，模型位址設為 http://model-bridge:18000。
# 通道從遠端取得 API key；金鑰與 known_hosts 唯讀掛載。
# 檔案路徑留空時使用 STUDYDY_DATA_DIR/ssh/ 下的預設檔案。
COMPOSE_PROFILES=
STUDYDY_SSH_HOST=
STUDYDY_SSH_PORT=22
STUDYDY_SSH_MODEL_PORT=18000
STUDYDY_SSH_KEY_FILE=
STUDYDY_SSH_KNOWN_HOSTS_FILE=

# 獨立語音辨識服務；token 只放私人環境設定。
STUDYDY_PODCAST_PROVIDER_URL=http://host.docker.internal:18091
STUDYDY_PODCAST_PROVIDER_TOKEN=
STUDYDY_SEARXNG_URL=http://research-search:8080
STUDYDY_OPENALEX_API_KEY=
STUDYDY_SEMANTIC_SCHOLAR_API_KEY=
STUDYDY_UNPAYWALL_EMAIL=

# 背景 worker 執行緒數，預設 1；依硬體（模型服務並行能力）調整。
STUDYDY_MATERIAL_WORKERS=1
STUDYDY_CARD_WORKERS=1
STUDYDY_PODCAST_WORKERS=1
STUDYDY_RESEARCH_WORKERS=1
